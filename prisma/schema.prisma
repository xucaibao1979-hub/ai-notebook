// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  parentUserId String?
  @@index([parentUserId])
  id        String   @id @default(cuid())
  email     String   @unique
  username  String?  @unique
  password  String
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  educationStage String? // primary, junior_high, senior_high, university
  enrollmentYear Int?
  studyPreferences String @default("{}")
  currentGrade Int?
  examDate String?

  role      String   @default("user") // "admin" or "user"
  isActive  Boolean  @default(true)   // 用户是否启用

  errorItems ErrorItem[]
  subjects   Subject[]
  practiceRecords PracticeRecord[]
  customTags KnowledgeTag[] // User's custom tags
  learningSets LearningSet[]
  weeklyReports WeeklyReport[]
}

// 统一知识点标签表 (支持无限层级)
model KnowledgeTag {
  id        String   @id @default(cuid())
  name      String   // 标签名，如 "勾股定理"
  subject   String   // 学科，如 "math", "english"

  // 层级控制 (邻接表模式)
  parentId  String?
  parent    KnowledgeTag?  @relation("TagHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children  KnowledgeTag[] @relation("TagHierarchy")

  // 排序与编码
  order     Int      @default(0) // 用于保持教材顺序
  code      String?              // 如 "1.2.1"

  // 区分系统预设 vs 用户自定义
  isSystem  Boolean  @default(false)
  userId    String?  // 如果是用户自定义标签，绑定 userId
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  // 与错题的多对多关系
  errorItems ErrorItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 联合索引：确保同一用户（或系统）下同一父节点下的标签名不重复
  @@unique([subject, name, userId, parentId])
  // 索引：加速父子查询
  @@index([parentId])
  @@index([subject])
}

model Subject {
  id     String @id @default(cuid())
  name   String
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  errorItems ErrorItem[]
  weeklyReports WeeklyReport[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, userId])
}

model ErrorItem {
  knowledgeCardLinks KnowledgeCardError[]
  favorited Boolean @default(false)
  archivedAt DateTime?
  solutionReviewedAt DateTime?
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjectId      String?
  subject        Subject? @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  
  originalImageUrl String
  ocrText          String?
  
  // AI Analysis
  questionText     String? // Parsed question
  answerText       String? // AI provided answer
  analysis         String? // AI analysis/explanation
  wrongAnswerText  String? // Student's wrong answer/work if visible
  mistakeAnalysis  String? // Analysis of why the wrong answer happened
  mistakeStatus    String? // not_attempted, wrong_attempt, unknown
  knowledgePoints  String? // [DEPRECATED] JSON string - kept for migration only
  geogebraCommands String? // GeoGebra commands for interactive demo (JSON or newline-separated)

  // New: many-to-many relation with KnowledgeTag
  tags             KnowledgeTag[]
  
  // User Metadata
  source           String? // e.g. "Midterm Exam"
  errorType        String? // e.g. "Calculation", "Concept"
  userNotes        String?
  
  masteryLevel     Int     @default(0) // 0: New, 1: Reviewing, 2: Mastered
  gradeSemester    String? // e.g. "Junior High Grade 2, 1st Semester"
  paperLevel       String? // e.g. "A", "B", "Other"
  
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  reviewSchedules ReviewSchedule[]
}

model KnowledgeCard {
  id String @id @default(cuid())
  userId String
  subject String
  title String
  concept String @default("")
  pitfall String @default("")
  method String @default("")
  grade String?
  chapter String?
  status String @default("reviewing")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  errors KnowledgeCardError[]
  @@unique([userId, subject, title])
  @@index([userId, updatedAt])
}

model KnowledgeCardError {
  cardId String
  errorItemId String
  card KnowledgeCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  errorItem ErrorItem @relation(fields: [errorItemId], references: [id], onDelete: Cascade)
  @@id([cardId, errorItemId])
  @@index([errorItemId])
}

model ReviewSchedule {
  id          String    @id @default(cuid())
  errorItemId String
  errorItem   ErrorItem @relation(fields: [errorItemId], references: [id], onDelete: Cascade)
  
  scheduledFor DateTime
  completedAt  DateTime?
  isCorrect    Boolean? // Result of the review
  
  createdAt    DateTime @default(now())
}

model PracticeRecord {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  subject   String?  // e.g. "Math", "Physics"
  difficulty String? // "easy", "medium", "hard", "harder"
  isCorrect Boolean?
  learningSetId String?
  learningSet LearningSet? @relation(fields: [learningSetId], references: [id], onDelete: Cascade)
  exerciseIndex Int?
  userAnswer String?
  
  createdAt DateTime @default(now())
  @@unique([userId, learningSetId, exerciseIndex])
}

model LearningSet {
  archivedAt DateTime?
  favorited Boolean @default(false)
  favoriteIndices String @default("[]")
  deletedIndices String @default("[]")
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  dateKey String?
  selectionKey String
  source String
  title String
  questions String
  parameters String @default("{}")
  createdAt DateTime @default(now())
  records PracticeRecord[]
  weeklyReports WeeklyReport[]
  @@unique([userId, dateKey, selectionKey])
  @@index([userId, createdAt])
}

model WeeklyReport {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  notebookId String?
  notebook Subject? @relation(fields: [notebookId], references: [id], onDelete: Cascade)
  notebookKey String
  weekKey String
  periodStart DateTime
  periodEnd DateTime
  statistics String
  summary String @default("")
  status String @default("pending")
  message String @default("")
  exerciseSetId String?
  exerciseSet LearningSet? @relation(fields: [exerciseSetId], references: [id], onDelete: SetNull)
  leaseUntil DateTime?
  retryAfter DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([userId, notebookKey, weekKey])
  @@index([userId, periodEnd])
}

model KnowledgePaper {
  id String @id @default(cuid())
  sourceUrl String @unique
  sourceName String
  title String
  year Int
  examType String
  subject String
  region String
  examGrade Int
  knowledgeGrades String @default("[]")
  questions String
  questionCount Int
  answerCount Int
  qualityNote String
  status String @default("unverified")
  attachments String @default("[]")
  fetchedAt DateTime @default(now())
  @@index([year, examType, subject])
  @@index([examGrade, region])
}

model PaperAttempt {
  durationSeconds Int @default(0)
  id String @id @default(cuid())
  userId String
  paperId String
  answers String @default("{}")
  completed Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([userId, paperId, updatedAt])
}

model AIUsage {
 inputTokens Int?
 outputTokens Int?
 errorReason String?
 id String @id @default(cuid())
 userId String?
 task String
 model String
 durationMs Int
 success Boolean
 createdAt DateTime @default(now())
 @@index([userId, createdAt])
}

model HomeworkReview {
 id String @id @default(cuid())
 userId String
 image String
 questions String
 scanQuestions String?
 createdAt DateTime @default(now())
 @@index([userId,createdAt])
}

model StudyCatalogRevision {
 id String @id @default(cuid())
 userId String
 action String
 snapshot String
 createdAt DateTime @default(now())
 @@index([userId, createdAt])
}

model StudyTask {
 id String @id @default(cuid())
 userId String
 kind String
 requestHash String
 status String @default("pending")
 input String
 result String?
 error String?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@index([userId, createdAt])
 @@index([userId, kind, requestHash])
}
